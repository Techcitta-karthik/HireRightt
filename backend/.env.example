APP_NAME=HireRight API
ENVIRONMENT=development
HOST=0.0.0.0
PORT=8787
DEBUG=false

# Local default. Use PostgreSQL in staging/production.
DATABASE_URL=sqlite:///./data/hireright.db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-this-secret-key-before-production
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
MAX_SESSIONS_PER_USER=10
SIGNUP_ENABLED=true
DOCS_ENABLED=true
MAX_REQUEST_BYTES=2000000
